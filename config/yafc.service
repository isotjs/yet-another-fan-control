[Unit]
Description=YAFC Daemon (Victus 16)
After=multi-user.target
# Requires hp_wmi kernel module to be loaded
After=systemd-modules-load.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/yafc-daemon
Restart=on-failure
RestartSec=5
# stdout goes to journald: journalctl -u yafc -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
